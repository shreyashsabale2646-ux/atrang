# Copy to .env and adjust as necessary for deployment or local testing.

# Frontend settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
ATRANG_PORT=3000

# PostgreSQL Database Configuration
POSTGRES_DB=atrang
POSTGRES_USER=atrang_app
POSTGRES_PASSWORD=atrang_secret_pass
POSTGRES_PORT=5432

# Backend Spring Boot Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/atrang
SPRING_DATASOURCE_USERNAME=atrang_app
SPRING_DATASOURCE_PASSWORD=atrang_secret_pass
ATRANG_ADMIN_USERNAME=admin
ATRANG_ADMIN_PASSWORD=admin123
ATRANG_FRONTEND_ORIGIN=http://localhost:3000
